#!/usr/bin/env -S rysh script
# Generated by `rysh import tmux`. Review it, then run it inside the session
# that should get this layout:
#   rysh script .rysh/imports/tmux-shop.rysh
# Each start command below runs in its new pane when you run this script;
# the import itself ran nothing.
set -euo pipefail

# The id of the newest tab: the last id= field that ##tab list printed.
newest_tab() { printf '%s\n' "${RYSH_OUT:-}" | sed -n 's/.* id=\([^ ]*\).*/\1/p' | tail -n 1; }

# tab 1: 3 lane(s), 3 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='dev'
##tab name $t $name
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate; python manage.py runserver'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
##new lane $t
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate; npm run watch'
##cmd stack --tab $t --lane 2 --pg 1 -- $c
##new lane $t
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate'
##cmd stack --tab $t --lane 3 --pg 1 -- $c

# tab 2: 1 lane(s), 2 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='db'
##tab name $t $name
##new pane $t 1
c='cd -- '\''/srv/db/sql'\'' && source .venv/bin/activate; psql shop'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
c='cd -- '\''/srv/db'\'' && source .venv/bin/activate'
##cmd stack --tab $t --lane 1 --pg 2 -- $c

# tab 3: 2 lane(s), 4 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='grid'
##tab name $t $name
##new pane $t 1
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate; htop'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate'
##cmd stack --tab $t --lane 1 --pg 2 -- $c
##new lane $t
##new pane $t 2
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate'
##cmd stack --tab $t --lane 2 --pg 1 -- $c
c='cd -- "$HOME"/'\''work/shop'\'' && source .venv/bin/activate'
##cmd stack --tab $t --lane 2 --pg 2 -- $c
