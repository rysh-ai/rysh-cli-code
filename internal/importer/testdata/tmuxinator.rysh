#!/usr/bin/env -S rysh script
# Generated by `rysh import tmux`. Review it, then run it inside the session
# that should get this layout:
#   rysh script .rysh/imports/tmux-blog.rysh
# Each start command below runs in its new pane when you run this script;
# the import itself ran nothing.
set -euo pipefail

# The id of the newest tab: the last id= field that ##tab list printed.
newest_tab() { printf '%s\n' "${RYSH_OUT:-}" | sed -n 's/.* id=\([^ ]*\).*/\1/p' | tail -n 1; }

# tab 1: 2 lane(s), 3 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='editor'
##tab name $t $name
c='cd -- "$HOME"/'\''code/blog'\'' && nvm use 20; vim'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
##new lane $t
##new pane $t 2
c='cd -- "$HOME"/'\''code/blog'\'' && nvm use 20; guard'
##cmd stack --tab $t --lane 2 --pg 1 -- $c
c='cd -- "$HOME"/'\''code/blog'\'' && nvm use 20; cd log; tail -f development.log'
##cmd stack --tab $t --lane 2 --pg 2 -- $c

# tab 2: 1 lane(s), 1 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='server'
##tab name $t $name
c='cd -- "$HOME"/'\''code/blog'\'' && nvm use 20; bundle exec rails s'
##cmd stack --tab $t --lane 1 --pg 1 -- $c

# tab 3: 2 lane(s), 2 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='deploy'
##tab name $t $name
c='cd -- "$HOME"/'\''code/blog-infra'\'' && nvm use 20; terraform plan'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
##new lane $t
c='cd -- "$HOME"/'\''code/blog-infra'\'' && nvm use 20'
##cmd stack --tab $t --lane 2 --pg 1 -- $c

# tab 4: 1 lane(s), 1 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='shell'
##tab name $t $name
c='cd -- "$HOME"/'\''code/blog'\'' && nvm use 20'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
