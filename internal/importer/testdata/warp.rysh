#!/usr/bin/env -S rysh script
# Generated by `rysh import warp`. Review it, then run it inside the session
# that should get this layout:
#   rysh script .rysh/imports/warp-dev.rysh
# Each start command below runs in its new pane when you run this script;
# the import itself ran nothing.
set -euo pipefail

# The id of the newest tab: the last id= field that ##tab list printed.
newest_tab() { printf '%s\n' "${RYSH_OUT:-}" | sed -n 's/.* id=\([^ ]*\).*/\1/p' | tail -n 1; }

# tab 1: 1 lane(s), 1 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='docs'
##tab name $t $name
c='cd -- "$HOME"/'\''Documents'\'' && ls -la'
##cmd stack --tab $t --lane 1 --pg 1 -- $c

# tab 2: 1 lane(s), 3 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='app'
##tab name $t $name
##new pane $t 1
##new pane $t 1
c='cd -- "$HOME"/'\''src/app'\'' && npm install; npm start'
##cmd stack --tab $t --lane 1 --pg 1 -- $c
c='cd -- "$HOME"/'\''src/app'\'' && npm test -- --watch'
##cmd stack --tab $t --lane 1 --pg 2 -- $c
c='cd -- '\''/srv/logs'\'''
##cmd stack --tab $t --lane 1 --pg 3 -- $c

# tab 3: 1 lane(s), 1 pane(s)
##new tab
##tab list
t="$(newest_tab)"
[ -n "$t" ] || { echo 'rysh import: could not find the new tab (run this file with rysh script)' >&2; exit 1; }
name='second window'
##tab name $t $name
c='cd -- '\''/tmp'\'''
##cmd stack --tab $t --lane 1 --pg 1 -- $c
